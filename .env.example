# ResumeVoice AI Configuration
# Copy to .env and adjust values

# LLM (vLLM / OpenAI-compatible API)
RESUMEVOICE_LLM_URL=http://localhost:8000/v1
RESUMEVOICE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
RESUMEVOICE_LLM_API_KEY=EMPTY

# STT (faster-whisper)
RESUMEVOICE_STT_MODEL=base
RESUMEVOICE_STT_DEVICE=cpu
RESUMEVOICE_STT_COMPUTE=int8

# TTS (Piper)
RESUMEVOICE_TTS_MODEL=/usr/share/piper/voices/en_US-lessac-medium.onnx

# VAD (Silero)
RESUMEVOICE_VAD_THRESHOLD=0.5

# Resume persona (personal voice agent)
# Disable the persona entirely with 0. Path can point to a .txt/.md or a PDF.
RESUMEVOICE_RESUME_ENABLED=1
RESUMEVOICE_RESUME_PATH=resume/resume.txt
