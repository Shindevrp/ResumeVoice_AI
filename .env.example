# ResumeVoice AI Configuration
# Copy to .env and adjust values

# LLM (vLLM / OpenAI-compatible API)
RESUMEVOICE_LLM_URL=http://localhost:8000/v1
RESUMEVOICE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
RESUMEVOICE_LLM_API_KEY=EMPTY
RESUMEVOICE_LLM_TEMPERATURE=0.7
RESUMEVOICE_LLM_MAX_TOKENS=512
RESUMEVOICE_LLM_TOP_P=0.9

# STT (faster-whisper)
RESUMEVOICE_STT_MODEL=base
RESUMEVOICE_STT_DEVICE=cuda
RESUMEVOICE_STT_COMPUTE=float16

# TTS (Piper)
RESUMEVOICE_TTS_MODEL=/usr/share/piper/voices/en_US-lessac-medium.onnx
RESUMEVOICE_TTS_DEVICE=cuda

# VAD (Silero)
RESUMEVOICE_VAD_THRESHOLD=0.45
RESUMEVOICE_VAD_DEVICE=cuda

# Emotion classification (optional; disabled automatically if it fails to load)
RESUMEVOICE_EMOTION_ENABLED=1

# Resume persona (personal voice agent)
# Disable the persona entirely with 0. Path can point to a .txt/.md or a PDF.
RESUMEVOICE_RESUME_ENABLED=1
RESUMEVOICE_RESUME_PATH=resume/resume.txt

# Hosting / platform deployment
# Bind address and port (used by `python3 -m app.cli server`)
RESUMEVOICE_HOST=0.0.0.0
RESUMEVOICE_PORT=8000

# Allowed CORS origins for browser clients (comma-separated). Defaults to
# localhost origins when unset. Add your public domain, e.g.:
#   RESUMEVOICE_CORS_ORIGINS=https://voice.example.com
RESUMEVOICE_CORS_ORIGINS=

# WebRTC ICE servers handed to browsers via /webrtc/config and used
# server-side. STUN is mandatory for NAT traversal; add a TURN relay
# (RESUMEVOICE_TURN_URL) when clients are behind restrictive NATs.
RESUMEVOICE_STUN_URL=stun:stun.l.google.com:19302
RESUMEVOICE_TURN_URL=
RESUMEVOICE_TURN_USERNAME=
RESUMEVOICE_TURN_CREDENTIAL=
